---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Journey from "../components/Journey.astro";
import Skills from "../components/Skills.astro";
import Interests from "../components/Interests.astro";
import Contact from "../components/Contact.astro";
import MotionScript from "../components/MotionScript.astro";
import { profile } from "../data/profile";

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  alumniOf: { "@type": "CollegeOrUniversity", name: "Epitech" },
  knowsAbout: ["Python", "Data", "Streamlit", "SQL", "JavaScript", "Développement web"],
  sameAs: [profile.github, profile.linkedin],
};
---

<BaseLayout page="home" jsonLd={person}>
  <Hero />
  <About />
  <Projects />
  <Journey />
  <Skills />
  <Interests />
  <Contact />
  <MotionScript />
</BaseLayout>
