---
/* La page CV. À l'écran : la composition artistique, une feuille A4 affichée
   en entier, avec un mode lecture pour l'agrandir. À l'impression et dans le
   PDF (npm run cv:pdf) : le document professionnel, CvSheet. */
import vt323 from "@fontsource/vt323/files/vt323-latin-400-normal.woff2?url";
import silkscreen from "@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url";
import silkscreenBold from "@fontsource/silkscreen/files/silkscreen-latin-700-normal.woff2?url";
import jetbrains from "@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url";
import BaseLayout from "../layouts/BaseLayout.astro";
import CvPoster from "../components/CvPoster.astro";
import CvSheet from "../components/CvSheet.astro";
import Icon from "../components/Icon.astro";
import { profile } from "../data/profile";
import { url } from "../lib/url";

const pdfName = "CV-Abdallah-Borji.pdf";
---

<BaseLayout
  page="cv"
  title={`${profile.name} · CV`}
  description={`CV d’${profile.name}, étudiant en Pré-MSc à Epitech : expériences, formation, projets et compétences, sur une page A4. Version imprimable et PDF.`}
>
  <Fragment slot="head">
    <link rel="preload" href={vt323} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={silkscreen} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={silkscreenBold} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={jetbrains} as="font" type="font/woff2" crossorigin />
  </Fragment>

  <div class="viewer" data-cv-viewer data-zoom="off">
    <div class="viewer__panel">
      <a class="link viewer__back" href={url("/")}><Icon name="arrow-left" /> Portfolio</a>
      <div class="viewer__info">
        <p class="viewer__kicker">CV · A4 · une page</p>
        <p class="viewer__note">À l’impression et en PDF, le même contenu passe en mise en page classique.</p>
      </div>
      <div class="viewer__actions">
        <button class="link needs-js" type="button" data-cv-zoom aria-pressed="false" aria-controls="cv-feuille">
          <span data-cv-zoom-label>Agrandir</span>
          <Icon name="zoom-in" class="viewer__zoom-in" />
          <Icon name="zoom-out" class="viewer__zoom-out" />
        </button>
        <button class="link needs-js" type="button" data-print>Imprimer <Icon name="printer" /></button>
        <a class="button" href={url(`/${pdfName}`)} download={pdfName}>Télécharger le PDF <Icon name="download" /></a>
      </div>
    </div>

    <div class="viewer__stage" data-cv-stage>
      <div class="viewer__sheet" id="cv-feuille" data-cv-sheet>
        <CvPoster />
      </div>
    </div>
  </div>

  <CvSheet />
</BaseLayout>

<style>
  /* ---------- La visionneuse ----------
     Vue d'ensemble : la feuille tient entièrement dans la fenêtre.
     Lecture : la feuille s'élargit et la page défile normalement. */
  .viewer {
    --pad: clamp(1rem, 3vh, 2rem);
    --panel: 15rem;
    --fit: calc((100dvh - var(--header-h) - 2 * var(--pad)) * 210 / 297);
    display: grid;
    gap: 1.25rem;
    padding: calc(var(--header-h) + var(--pad)) var(--gutter) var(--pad);
  }

  .viewer__panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 1.5rem;
    font-size: var(--fs-small);
  }

  .viewer__info {
    display: none;
  }

  .viewer__kicker {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .viewer__note {
    margin-top: 0.6rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .viewer__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }

  [data-zoom="off"] :global(.viewer__zoom-out),
  [data-zoom="on"] :global(.viewer__zoom-in) {
    display: none;
  }

  /* Masqués sans JavaScript ; la classe .js est posée avant le premier
     affichage, donc les boutons ne font rien bouger en apparaissant. */
  :global(html:not(.js)) .needs-js {
    display: none;
  }

  .viewer__stage {
    min-width: 0;
  }

  .viewer__sheet {
    container-type: inline-size;
    width: 100%;
    margin-inline: auto;
    box-shadow:
      0 0 0 1px var(--line),
      var(--shadow);
  }

  :global(.js) .viewer__sheet {
    cursor: zoom-in;
  }

  :global(.js) [data-zoom="on"] .viewer__sheet {
    cursor: zoom-out;
  }

  /* Ordinateur : les commandes à gauche, la feuille au centre de l'écran. */
  @media (min-width: 64em) {
    .viewer {
      grid-template-columns: minmax(var(--panel), 1fr) auto minmax(0, 1fr);
      align-items: start;
      min-height: 100dvh;
      gap: 2.5rem;
    }

    .viewer__panel {
      position: sticky;
      top: calc(var(--header-h) + var(--pad));
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: flex-start;
      justify-content: flex-start;
      gap: 2rem;
      max-width: 18rem;
    }

    .viewer__info {
      display: block;
    }

    .viewer__actions {
      flex-direction: column;
      align-items: flex-start;
    }

    .viewer__sheet {
      width: max(20rem, min(var(--fit), 100vw - 2 * var(--gutter) - 2 * var(--panel) - 5rem));
    }

    [data-zoom="on"] {
      grid-template-columns: minmax(var(--panel), 18rem) minmax(0, 1fr);
    }

    [data-zoom="on"] .viewer__sheet {
      width: min(100%, 72rem);
    }
  }

  /* Téléphone et tablette : la feuille prend toute la largeur ; en lecture,
     elle s'élargit et se parcourt dans les deux sens. */
  @media (max-width: 63.99em) {
    [data-zoom="on"] .viewer__stage {
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      overscroll-behavior-x: contain;
    }

    [data-zoom="on"] .viewer__sheet {
      width: max(100%, 56rem);
    }
  }

  /* ---------- Impression : le document professionnel, seul ---------- */
  @media print {
    @page {
      size: A4;
      margin: 0;
    }

    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    .viewer {
      display: none !important;
    }

    :global(html),
    :global(body) {
      min-height: 0;
      background: #fff;
    }
  }
</style>
