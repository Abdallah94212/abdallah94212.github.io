---
import HeroScene from "./HeroScene.astro";
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
import { url } from "../lib/url";

// Le nom est découpé en lettres dès le build : l'entrée en scène est en CSS
// pur et démarre au premier affichage, sans attendre aucun script.
const firstChars = [...profile.firstName];
const lastChars = [...profile.lastName];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__grid wrap">
    <p class="hero__kicker label" data-intro style="--d: 0.3s">
      {profile.kicker.map((line) => <span>{line}</span>)}
    </p>

    <div class="hero__copy">
      <p class="hero__statement" data-intro style="--d: 0.4s">{profile.statement}</p>
      <div class="hero__actions" data-intro style="--d: 0.6s">
        <a class="button" href="#projets">Voir les projets <Icon name="arrow-down-right" /></a>
        <a class="link" href={url("/cv/")}>Lire le CV <Icon name="arrow-up-right" /></a>
      </div>
    </div>

    <div class="hero__name-wrap">
      <h1 id="hero-title" class="hero__name" data-hero-name>
        <span class="visually-hidden">{profile.name}</span>
        <span class="hero__line hero__line--first" aria-hidden="true">
          {firstChars.map((char, index) => <span class="hero__char" style={`--i: ${index}`}>{char}</span>)}
          <span class="hero__shine">{firstChars.map((char) => <span class="hero__shine-char">{char}</span>)}</span>
        </span>
        <span class="hero__line hero__line--last" aria-hidden="true">
          {lastChars.map((char, index) => <span class="hero__char" style={`--i: ${firstChars.length + index}`}>{char}</span>)}<span class="hero__char hero__dot">.</span>
        </span>
      </h1>
    </div>

    <HeroScene />
  </div>
</section>

<style>
  .hero {
    /* Les lettres de « Abdallah » mesurent 4,57 em (largeur 125 %) : le nom
       occupe toute la largeur utile, sans dépasser la grille sur grand écran. */
    --name-fit: calc((min(100vw, var(--max)) - 2 * var(--gutter)) / 4.62);
    --name-size: min(var(--name-fit), 30svh);
    position: relative;
    min-height: 100svh;
    display: flex;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem));
    padding-bottom: clamp(1rem, 2.5vh, 2rem);
    /* Seul l'axe horizontal est coupé : les jambages (le « j ») restent entiers. */
    overflow-x: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(1rem, 2vw, 2rem);
    width: 100%;
  }

  /* Sur grand écran, la maquette dit déjà « Epitech » et « data, web » :
     l'accroche ne s'affiche qu'en colonne unique. */
  .hero__kicker {
    display: none;
    align-content: start;
    color: var(--muted);
  }

  /* La maquette occupe le coin libre au-dessus du prénom : sa hauteur suit
     celle de la déclaration, sa largeur s'en déduit (format fixe). Sa
     légende se loge à gauche de « Borji. », sur la ligne du nom. */
  .hero__grid :global(.scene__art) {
    grid-column: 1 / 7;
    grid-row: 1 / 3;
    container-type: size;
  }

  .hero__grid :global(.legend) {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 3;
    align-self: end;
    width: calc(100% - var(--name-size) * 2.45);
    margin-bottom: calc(var(--name-size) * 0.08);
  }

  .hero__copy {
    grid-column: 7 / -1;
    grid-row: 1;
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
    justify-items: start;
  }

  .hero__statement {
    max-width: 19ch;
    font-size: clamp(1.75rem, 1rem + 2.1vw, 3.1rem);
    font-weight: 560;
    font-stretch: 106%;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .hero__name-wrap {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 3;
    font-size: var(--name-size);
    margin-top: clamp(1.5rem, 4vh, 3rem);
  }

  .hero__name {
    display: grid;
    font-size: 1em;
    font-weight: 780;
    font-stretch: 125%;
    line-height: 0.84;
    letter-spacing: -0.055em;
    /* Les lettres débordent légèrement de leur boîte : on évite toute coupe. */
    padding-bottom: 0.04em;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  .hero__line--first {
    position: relative;
    margin-left: -0.05em;
  }

  /* Reflet du prénom : une copie exacte des lettres, transparente, que
     traverse un dégradé bleu (background-clip: text). Les vraies lettres ne
     changent jamais : au repos, le prénom reste parfaitement net. */
  .hero__shine {
    display: none;
  }

  .hero__line--last {
    justify-self: end;
    margin-right: -0.02em;
  }

  .hero__dot {
    color: var(--accent);
    transform-origin: 50% 80%;
  }

  /* ---------- Entrée en scène, en CSS pur ----------
     Les lettres montent depuis leur ligne, puis le point se pose. Lors d'une
     visite suivante dans la session, tout va deux fois plus vite
     (classe intro-seen posée dans le <head>). */

  .hero__char {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero {
      --speed: 1;
    }

    .hero__shine {
      --shine-edge: color-mix(in srgb, var(--accent) 50%, transparent);
      --shine-core: color-mix(in srgb, color-mix(in srgb, var(--accent) 62%, #fff) 85%, transparent);
      position: absolute;
      inset: 0;
      display: block;
      color: transparent;
      /* Comme les vraies lettres, posées une par une : pas de crénage. */
      font-kerning: none;
      background: linear-gradient(
          105deg,
          transparent 47.6%,
          var(--shine-edge) 49.1%,
          var(--shine-core) 50%,
          var(--shine-edge) 50.9%,
          transparent 52.4%
        )
        72% 0 / 400% 100% no-repeat;
      -webkit-background-clip: text;
      background-clip: text;
      pointer-events: none;
      animation: name-shine 7s calc(2.4s * var(--speed)) infinite;
    }

    .hero__shine-char {
      display: inline-block;
    }

    :global(html.intro-seen) .hero {
      --speed: 0.45;
    }

    /* La ligne masque les lettres pendant leur montée, puis libère les
       jambages (le « j ») une fois l'entrée terminée. */
    .hero__line {
      animation: line-mask calc(1.9s * var(--speed)) steps(1, jump-end) both;
    }

    .hero__char {
      animation: char-rise calc(1.3s * var(--speed)) var(--ease-out) calc((0.1s + var(--i) * 0.04s) * var(--speed)) backwards;
    }

    .hero__dot {
      animation: dot-pop calc(0.9s * var(--speed)) cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.85s * var(--speed)) backwards;
    }

    [data-intro] {
      animation: intro-fade calc(1s * var(--speed)) var(--ease-out) calc(var(--d, 0s) * var(--speed)) backwards;
    }
  }

  @keyframes line-mask {
    from {
      clip-path: inset(-25% -5% -0.08em -5%);
    }
    to {
      clip-path: none;
    }
  }

  @keyframes char-rise {
    from {
      transform: translateY(118%);
    }
  }

  /* Un passage d'environ 2,2 s, puis le repos : un cycle toutes les 7 s. */
  @keyframes name-shine {
    0% {
      background-position: 72% 0;
      animation-timing-function: cubic-bezier(0.37, 0, 0.63, 1);
    }
    32%,
    100% {
      background-position: 28% 0;
    }
  }

  @keyframes dot-pop {
    from {
      transform: scale(0);
    }
  }

  @keyframes intro-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  /* ---------- Tablette et mobile ---------- */

  @media (max-width: 900px) {
    .hero {
      --name-size: var(--name-fit);
      min-height: auto;
      padding-top: calc(var(--header-h) + 2rem);
      padding-bottom: 3rem;
    }

    .hero__grid {
      display: flex;
      flex-direction: column;
    }

    .hero__kicker {
      order: 1;
      display: grid;
    }

    .hero__name-wrap {
      display: contents;
    }

    .hero__name {
      order: 2;
      margin-top: 1.25rem;
      font-size: var(--name-size);
    }

    .hero__copy {
      order: 3;
      margin-top: 2rem;
    }

    .hero__grid :global(.scene__art) {
      order: 4;
      container-type: inline-size;
      margin-top: 3.5rem;
    }

    .hero__grid :global(.legend) {
      order: 5;
      width: 100%;
      margin: 2.25rem 0 0;
    }
  }
</style>
