---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
import { projects } from "../data/projects";
import { projectUrl, url } from "../lib/url";

const first = projects[0];
// Le nom est découpé en lettres dès le build : l'entrée en scène est en CSS
// pur et démarre au premier affichage, sans attendre aucun script.
const firstChars = [...profile.firstName];
const lastChars = [...profile.lastName];
---

<section class="hero" data-hero aria-labelledby="hero-title">
  <div class="hero__grid wrap">
    <p class="hero__kicker label" data-intro style="--d: 0.3s">
      {profile.kicker.map((line) => <span>{line}</span>)}
    </p>

    <div class="hero__copy">
      <p class="hero__statement" data-intro style="--d: 0.4s">{profile.statement}</p>
      <div class="hero__actions" data-intro style="--d: 0.6s">
        <a class="button" href="#projets">Voir les projets <Icon name="arrow-down-right" /></a>
        <a class="link" href={url("/cv/")}>Lire le CV <Icon name="arrow-up-right" /></a>
      </div>
    </div>

    <div class="hero__name-wrap">
      <h1 id="hero-title" class="hero__name" data-hero-name>
        <span class="visually-hidden">{profile.name}</span>
        <span class="hero__line hero__line--first" aria-hidden="true">
          {firstChars.map((char, index) => <span class="hero__char" style={`--i: ${index}`}>{char}</span>)}
        </span>
        <span class="hero__line hero__line--last" aria-hidden="true">
          {lastChars.map((char, index) => <span class="hero__char" style={`--i: ${firstChars.length + index}`}>{char}</span>)}<span class="hero__char hero__dot">.</span>
        </span>
      </h1>

      <!-- Fenêtre de projets : de vraies captures, qui défilent seules
           et s'arrêtent au survol, au focus ou avec le bouton pause. -->
      <div class="reel" data-reel>
        <a class="reel__link" href={projectUrl(first.slug)} data-reel-link data-astro-prefetch>
          <span class="reel__frame">
            {
              projects.map((project, index) => (
                <Picture
                  src={project.cover.src}
                  alt=""
                  formats={["avif", "webp"]}
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 900px) 42vw, 92vw"
                  class={index === 0 ? "reel__img is-active" : "reel__img"}
                  loading={index === 0 ? "eager" : "lazy"}
                  fetchpriority={index === 0 ? "high" : "auto"}
                  decoding="async"
                  data-reel-slide
                  data-title={project.title}
                  data-href={projectUrl(project.slug)}
                />
              ))
            }
          </span>
          <span class="reel__caption">
            <span class="reel__kind">Projet</span>
            <span class="reel__title" data-reel-title>{first.title}</span>
            <Icon name="arrow-up-right" />
          </span>
        </a>
        <div class="reel__controls">
          <span class="reel__progress" aria-hidden="true">
            {projects.map(() => <span class="reel__segment"><span /></span>)}
          </span>
          <button class="reel__toggle" type="button" data-reel-toggle aria-label="Mettre en pause le défilement des projets" hidden>
            <Icon name="pause" class="reel__icon-pause" />
            <Icon name="play" class="reel__icon-play" />
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Les lettres de « Abdallah » mesurent 4,57 em (largeur 125 %) : le nom
       occupe toute la largeur utile, sans dépasser la grille sur grand écran. */
    --name-fit: calc((min(100vw, var(--max)) - 2 * var(--gutter)) / 4.62);
    --name-size: min(var(--name-fit), 30svh);
    position: relative;
    min-height: 100svh;
    display: flex;
    padding-top: calc(var(--header-h) + clamp(1.5rem, 4vh, 3rem));
    padding-bottom: clamp(1rem, 2.5vh, 2rem);
    /* Seul l'axe horizontal est coupé : les jambages (le « j ») restent entiers. */
    overflow-x: clip;
  }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(1rem, 2vw, 2rem);
    width: 100%;
  }

  .hero__kicker {
    grid-column: 1 / 6;
    grid-row: 1;
    display: grid;
    align-content: start;
    color: var(--muted);
  }

  .hero__copy {
    grid-column: 7 / -1;
    grid-row: 1;
    display: grid;
    gap: clamp(1.25rem, 3vh, 2rem);
    justify-items: start;
  }

  .hero__statement {
    max-width: 19ch;
    font-size: clamp(1.75rem, 1rem + 2.1vw, 3.1rem);
    font-weight: 560;
    font-stretch: 106%;
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .hero__name-wrap {
    position: relative;
    grid-column: 1 / -1;
    grid-row: 3;
    font-size: var(--name-size);
    margin-top: clamp(1.5rem, 4vh, 3rem);
  }

  .hero__name {
    display: grid;
    font-size: 1em;
    font-weight: 780;
    font-stretch: 125%;
    line-height: 0.84;
    letter-spacing: -0.055em;
    /* Les lettres débordent légèrement de leur boîte : on évite toute coupe. */
    padding-bottom: 0.04em;
  }

  .hero__line {
    display: block;
    white-space: nowrap;
  }

  .hero__line--first {
    margin-left: -0.05em;
  }

  .hero__line--last {
    justify-self: end;
    margin-right: -0.02em;
  }

  .hero__dot {
    color: var(--accent);
    transform-origin: 50% 80%;
  }

  /* ---------- Fenêtre de projets ---------- */

  .reel {
    position: absolute;
    left: 0;
    bottom: 0.06em;
    width: calc(100% - 2.75em);
    font-size: inherit;
  }

  .reel__link {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .reel__frame {
    position: relative;
    display: block;
    /* Proportionnelle au nom : elle tient toujours sous la première ligne. */
    height: 0.62em;
    border-radius: var(--radius-media);
    overflow: hidden;
    background: var(--line);
    isolation: isolate;
  }

  .reel__frame :global(picture),
  .reel__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .reel__frame :global(img) {
    object-fit: cover;
    object-position: 50% 12%;
    opacity: 0;
    transform: scale(1.08);
    transition:
      opacity 0.9s var(--ease-out),
      transform 1.6s var(--ease-out);
  }

  .reel__frame :global(img.is-active) {
    opacity: 1;
    transform: none;
  }

  .reel__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: calc(100% + 0.6rem);
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: var(--fs-small);
    font-weight: 560;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .reel__kind {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    font-weight: 450;
    color: var(--muted);
  }

  .reel__caption :global(.icon) {
    align-self: center;
    margin-left: auto;
    transition: transform var(--dur) var(--ease-out);
  }

  /* Un voile sombre en bas de l'image garde les contrôles lisibles. */
  .reel__frame::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 45%;
    background: linear-gradient(to top, rgb(12 14 19 / 50%), transparent);
    pointer-events: none;
  }

  .reel__controls {
    position: absolute;
    z-index: 2;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.75rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    pointer-events: none;
  }

  .reel__progress {
    flex: 1;
    display: grid;
    grid-auto-flow: column;
    gap: 0.35rem;
  }

  .reel__segment {
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 35%);
    overflow: hidden;
    box-shadow: 0 0 0 0.5px rgb(0 0 0 / 15%);
  }

  .reel__segment > span {
    display: block;
    height: 100%;
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
  }

  .reel__segment.is-done > span {
    transform: none;
  }

  .reel__segment.is-active > span {
    animation: reel-progress var(--reel-duration, 3.6s) linear forwards;
  }

  .reel.is-paused .reel__segment.is-active > span {
    animation-play-state: paused;
  }

  @keyframes reel-progress {
    to {
      transform: none;
    }
  }

  .reel__toggle {
    pointer-events: auto;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: rgb(12 14 19 / 55%);
    color: #fff;
    font-size: 0.9rem;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .reel__toggle :global(.reel__icon-play),
  .reel.is-paused .reel__toggle :global(.reel__icon-pause) {
    display: none;
  }

  .reel.is-paused .reel__toggle :global(.reel__icon-play) {
    display: block;
  }

  @media (hover: hover) and (pointer: fine) {
    .reel__link:hover :global(img.is-active) {
      transform: scale(1.03);
    }

    .reel__link:hover .reel__caption :global(.icon) {
      transform: translate(3px, -3px);
    }
  }

  /* ---------- Entrée en scène, en CSS pur ----------
     Les lettres montent depuis leur ligne, puis le point se pose. Lors d'une
     visite suivante dans la session, tout va deux fois plus vite
     (classe intro-seen posée dans le <head>). */

  .hero__char {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero {
      --speed: 1;
    }

    :global(html.intro-seen) .hero {
      --speed: 0.45;
    }

    /* La ligne masque les lettres pendant leur montée, puis libère les
       jambages (le « j ») une fois l'entrée terminée. */
    .hero__line {
      animation: line-mask calc(1.9s * var(--speed)) steps(1, jump-end) both;
    }

    .hero__char {
      animation: char-rise calc(1.3s * var(--speed)) var(--ease-out) calc((0.1s + var(--i) * 0.04s) * var(--speed)) backwards;
    }

    .hero__dot {
      animation: dot-pop calc(0.9s * var(--speed)) cubic-bezier(0.34, 1.56, 0.64, 1) calc(0.85s * var(--speed)) backwards;
    }

    [data-intro] {
      animation: intro-fade calc(1s * var(--speed)) var(--ease-out) calc(var(--d, 0s) * var(--speed)) backwards;
    }

    /* Sur grand écran, la fenêtre de projets s'ouvre de bas en haut. Sur mobile,
       c'est le plus grand élément de l'écran : elle s'affiche tout de suite. */
    @media (min-width: 901px) {
      .reel__frame {
        animation: reel-open calc(1.3s * var(--speed)) var(--ease-in-out) calc(0.35s * var(--speed)) backwards;
      }

      .reel__caption,
      .reel__controls {
        animation: intro-fade calc(0.8s * var(--speed)) var(--ease-out) calc(1.1s * var(--speed)) backwards;
      }
    }
  }

  @keyframes line-mask {
    from {
      clip-path: inset(-25% -5% -0.08em -5%);
    }
    to {
      clip-path: none;
    }
  }

  @keyframes char-rise {
    from {
      transform: translateY(118%);
    }
  }

  @keyframes dot-pop {
    from {
      transform: scale(0);
    }
  }

  @keyframes intro-fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @keyframes reel-open {
    from {
      clip-path: inset(100% 0 0 0 round 10px);
    }
  }

  /* ---------- Tablette et mobile ---------- */

  @media (max-width: 900px) {
    .hero {
      --name-size: var(--name-fit);
      min-height: auto;
      padding-top: calc(var(--header-h) + 2rem);
      padding-bottom: 3rem;
    }

    .hero__grid {
      display: flex;
      flex-direction: column;
    }

    .hero__kicker {
      order: 1;
    }

    .hero__name-wrap {
      display: contents;
    }

    .hero__name {
      order: 2;
      margin-top: 1.25rem;
      font-size: var(--name-size);
    }

    .hero__copy {
      order: 3;
      margin-top: 2rem;
    }

    .reel {
      order: 4;
      position: relative;
      bottom: auto;
      width: 100%;
      margin-top: 3.25rem;
      font-size: 1rem;
    }

    .reel__frame {
      height: auto;
      aspect-ratio: 16 / 10;
    }
  }
</style>
