---
import Icon from "./Icon.astro";
import ProjectPanel from "./ProjectPanel.astro";
import { archive, projects } from "../data/projects";
---

<section class="projects" id="projets" aria-labelledby="projects-title">
  <header class="projects__head wrap">
    <h2 class="section-title" id="projects-title" data-reveal="title">Projets</h2>
    <div class="projects__intro" data-reveal="fade">
      <p>Deux applications data, un projet d’équipe, un site vitrine. Le code de chacun est sur GitHub.</p>
      <p class="label">Captures prises en lançant chaque projet, sans retouche.</p>
    </div>
  </header>

  <div class="projects__stack" data-project-stack>
    {projects.map((project) => <ProjectPanel project={project} />)}
  </div>

  <div class="archive wrap">
    <h3 class="archive__title" id="archive-title">Aussi sur GitHub</h3>
    <ul class="archive__list">
      {
        archive.map((repo) => (
          <li>
            <a class="archive__row" href={repo.url} target="_blank" rel="noopener noreferrer">
              <span class="archive__name">{repo.name}</span>
              <span class="archive__text">{repo.text}</span>
              <span class="archive__stack label">{repo.stack}</span>
              <Icon name="arrow-up-right" class="archive__icon" />
              <span class="visually-hidden"> (GitHub, nouvel onglet)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .projects {
    padding-top: calc(var(--section) * 0.6);
  }

  .projects__head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    align-items: end;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .projects__head .section-title {
    grid-column: 1 / 8;
  }

  .projects__intro {
    grid-column: 9 / -1;
    display: grid;
    gap: 0.75rem;
    padding-bottom: 0.6rem;
  }

  .projects__intro p:first-child {
    font-size: var(--fs-lead);
    line-height: 1.3;
    letter-spacing: -0.015em;
  }

  /* ---------- Autres dépôts ---------- */

  .archive {
    padding-block: var(--section) calc(var(--section) * 0.5);
  }

  .archive__title {
    font-size: var(--fs-h3);
    font-weight: 700;
    margin-bottom: 2rem;
  }

  .archive__list {
    border-top: 1px solid var(--line);
  }

  .archive__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(10rem, 1.1fr) 2fr minmax(9rem, 1fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    padding: 1.35rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    isolation: isolate;
    transition: color var(--dur) var(--ease-out);
  }

  /* Au survol, l'encre remplit la ligne de gauche à droite. */
  .archive__row::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--ink);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform var(--dur) var(--ease-out);
  }

  .archive__name {
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.75rem);
    font-weight: 680;
    font-stretch: 110%;
    letter-spacing: -0.03em;
  }

  .archive__text {
    color: var(--muted);
    font-size: var(--fs-small);
  }

  .archive__row :global(.archive__icon) {
    align-self: center;
    font-size: 1.25rem;
    transition: transform var(--dur) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .archive__row:hover {
      color: var(--bg);
    }

    .archive__row:hover::before {
      transform: none;
    }

    .archive__row:hover .archive__text,
    .archive__row:hover .archive__stack {
      color: color-mix(in srgb, var(--bg) 70%, transparent);
    }

    .archive__row:hover :global(.archive__icon) {
      transform: translate(3px, -3px);
    }
  }

  @media (max-width: 900px) {
    .projects__head .section-title,
    .projects__intro {
      grid-column: 1 / -1;
    }

    .projects__intro {
      margin-top: 1.5rem;
    }

    .archive__row {
      grid-template-columns: 1fr auto;
      gap: 0.35rem 1rem;
      padding-inline: 0;
    }

    .archive__text,
    .archive__stack {
      grid-column: 1;
    }

    .archive__row :global(.archive__icon) {
      grid-column: 2;
      grid-row: 1;
    }
  }
</style>
