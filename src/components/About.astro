---
import { facts, profile } from "../data/profile";
---

<section class="about wrap" id="a-propos" aria-labelledby="about-title">
  <h2 id="about-title" class="about__label label">À propos</h2>
  <p class="about__text" data-scrub-text>{profile.manifesto}</p>

  <dl class="facts">
    {
      facts.map((fact) => (
        <div class="fact" data-reveal="rule">
          <dt class="fact__value">{fact.value}</dt>
          <dd class="fact__label">{fact.label}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  .about {
    position: relative;
    padding-block: var(--section) calc(var(--section) * 0.8);
  }

  .about__label {
    position: absolute;
    left: var(--gutter);
    margin-top: 0.9em;
  }

  .about__text {
    max-width: 24ch;
    margin-left: auto;
    margin-right: 8%;
    font-size: clamp(2rem, 1.05rem + 3.3vw, 4.4rem);
    font-weight: 560;
    font-stretch: 104%;
    line-height: 1.07;
    letter-spacing: -0.032em;
    text-indent: 1.6em;
    text-wrap: pretty;
  }

  .about__text :global(*) {
    text-indent: 0;
  }

  .about__text :global(.scrub-word) {
    color: color-mix(in srgb, var(--ink) calc(var(--lit, 1) * 100%), var(--muted));
  }

  .facts {
    display: grid;
    grid-template-columns: 1.25fr 1fr 1fr;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin-top: clamp(4.5rem, 10vw, 9rem);
  }

  .fact {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding-top: 1.25rem;
  }

  /* Le filet se trace quand le repère entre à l'écran (voir reveal.ts). */
  .fact::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: var(--line-strong);
    transform-origin: left;
    transform: scaleX(var(--rule, 1));
  }

  .fact__value {
    font-size: clamp(2.25rem, 1.4rem + 2.6vw, 4.25rem);
    font-weight: 740;
    font-stretch: 116%;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .fact__label {
    max-width: 30ch;
    font-size: var(--fs-small);
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .about__label {
      position: static;
      margin: 0 0 1.5rem;
    }

    .about__text {
      margin: 0;
      text-indent: 0;
    }

    .facts {
      grid-template-columns: 1fr;
      gap: 2.25rem;
    }

    /* En colonne : Epitech d'abord, le prix au milieu, l'expérience ensuite. */
    .fact:nth-child(1) {
      order: 3;
    }

    .fact:nth-child(2) {
      order: 2;
    }

    .fact:nth-child(3) {
      order: 1;
    }
  }
</style>
