---
/* Le CV en version artistique : une affiche au format A4, affichée sur le
   site. Une fiche profil d'ordinateur des années 2000 : aplat bleu électrique,
   fenêtres à barre de titre, typographie pixel, logos des outils en icônes
   de bureau. Tout est composé en millimètres de feuille (--u = 1 mm), donc la
   composition garde exactement ses proportions à toutes les tailles.

   Les graphiques sont calculés à partir des données, jamais dessinés à la
   main : radar (projets où chaque outil a servi, d'après profile.ts),
   frise (formation), QR code (adresse du portfolio).
   À l'impression et dans le PDF, c'est CvSheet qui prend le relais. */
import "@fontsource/vt323/latin-400.css";
import "@fontsource/silkscreen/latin-400.css";
import "@fontsource/silkscreen/latin-700.css";
import "@fontsource/jetbrains-mono/latin-400.css";
import "@fontsource/jetbrains-mono/latin-500.css";
import QRCode from "qrcode";
import Logo from "./Logo.astro";
import { languages, profile, skillGroups } from "../data/profile";
import { projectBySlug } from "../data/projects";
import { cvAward, cvEducation, cvExperience, cvHeadline, cvInterests, cvMethods, cvProjects, cvSummary, cvToolbox } from "../data/cv";
import { fr } from "../lib/fr";
import { projectUrl, url } from "../lib/url";

const site = Astro.site ? new URL(url("/"), Astro.site).href : undefined;
const shortUrl = (href: string) => href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");

const projects = cvProjects.map((item, index) => {
  const project = projectBySlug(item.slug);
  if (!project) throw new Error(`Projet introuvable : ${item.slug}`);
  return { ...item, index: String(index + 1).padStart(2, "0"), title: project.title, href: projectUrl(item.slug) };
});

/* ---------- Fiche d'identité ---------- */
const fiche = [
  { label: "Statut", value: cvHeadline.status.replace(/ à .*$/, "") },
  { label: "École", value: cvEducation[0].place },
  { label: "Domaines", value: cvHeadline.fields },
  { label: "Basé à", value: profile.location },
  { label: "Distinction", value: `${cvAward.title}, ${cvAward.when}` },
];

/* ---------- Langues : niveau du CECRL sur six cases (A1 à C2) ---------- */
const cefr = ["A1", "A2", "B1", "B2", "C1", "C2"];
const spoken = languages.map((language) => ({ ...language, rank: cefr.indexOf(language.level) + 1 }));

/* ---------- Radar : projets et expériences où chaque outil a servi ---------- */
const radarAxes = [
  { skill: "Python", label: "Python" },
  { skill: "Streamlit", label: "Streamlit" },
  { skill: "Visualisation", label: "Dataviz" },
  { skill: "SQL & SQL Server", label: "SQL" },
  { skill: "JavaScript", label: "JavaScript" },
  { skill: "Docker", label: "Docker" },
];
const allSkills = skillGroups.flatMap((group) => group.skills);
const radar = radarAxes.map(({ skill, label }, i) => {
  const found = allSkills.find((item) => item.name === skill);
  if (!found) throw new Error(`Compétence introuvable : ${skill}`);
  const angle = ((-90 + i * 60) * Math.PI) / 180;
  return { label, value: found.usedIn.length, cos: Math.cos(angle), sin: Math.sin(angle) };
});
const radarMax = Math.max(...radar.map((axis) => axis.value));
const point = (r: number, axis: (typeof radar)[number]) => `${(r * axis.cos).toFixed(3)},${(r * axis.sin).toFixed(3)}`;
const radarRings = Array.from({ length: radarMax }, (_, k) => radar.map((axis) => point((k + 1) / radarMax, axis)).join(" "));
const radarShape = radar.map((axis) => point(axis.value / radarMax, axis)).join(" ");

/* ---------- Trame déformée, comme une surface vue en perspective ---------- */
function warpedMesh(cols: number, rows: number, bulge: number) {
  const at = (u: number, v: number) => {
    const x = 0.5 + (u - 0.5) * (1 + bulge * Math.sin(Math.PI * v));
    const y = 0.5 + (v - 0.5) * (1 + bulge * 0.6 * Math.sin(Math.PI * u));
    return `${(x * 100).toFixed(2)} ${(y * 100).toFixed(2)}`;
  };
  const steps = 24;
  const line = (fn: (t: number) => string) => "M" + Array.from({ length: steps + 1 }, (_, s) => fn(s / steps)).join("L");
  const vertical = Array.from({ length: cols + 1 }, (_, c) => line((t) => at(c / cols, t)));
  const horizontal = Array.from({ length: rows + 1 }, (_, r) => line((t) => at(t, r / rows)));
  return [...vertical, ...horizontal].join("");
}
const mesh = warpedMesh(14, 10, 0.22);

/* ---------- Frise de formation, de la plus ancienne à la recherche en cours ---------- */
const timeline = [
  ...[...cvEducation].reverse().map((entry) => ({ when: entry.when, title: entry.title, place: entry.place.split(",")[0], brief: entry.brief, future: false })),
  { when: "2027", title: "Alternance", place: "Janvier – août 2027", brief: undefined, future: true },
];

/* ---------- QR code vers le portfolio (une case = un module) ---------- */
const qr = site ? QRCode.create(site, { errorCorrectionLevel: "M" }) : undefined;
const qrSize = qr?.modules.size ?? 0;
let qrPath = "";
for (let y = 0; y < qrSize; y++) {
  for (let x = 0; x < qrSize; x++) if (qr?.modules.data[y * qrSize + x]) qrPath += `M${x} ${y}h1v1h-1z`;
}

/* ---------- Curseur pixel (B : contour, W : remplissage) ---------- */
const cursor = [
  "B...........",
  "BB..........",
  "BWB.........",
  "BWWB........",
  "BWWWB.......",
  "BWWWWB......",
  "BWWWWWB.....",
  "BWWWWWWB....",
  "BWWWWWWWB...",
  "BWWWWWWWWB..",
  "BWWWWWWWWWB.",
  "BWWWWWWBBBBB",
  "BWWWBWWB....",
  "BWWBBWWB....",
  "BWB..BWWB...",
  "BB...BWWB...",
  "B.....BWWB..",
  "......BWWB..",
  ".......BB...",
];
const cursorPath = (key: string) =>
  cursor.flatMap((row, y) => [...row].map((cell, x) => (cell === key ? `M${x} ${y}h1v1h-1z` : ""))).join("");

/* Étoile à quatre branches, en coordonnées -1..1. */
const sparkle = "M0 -1C.1 -.1 .1 -.1 1 0C.1 .1 .1 .1 0 1C-.1 .1 -.1 .1 -1 0C-.1 -.1 -.1 -.1 0 -1Z";
---

<article class="poster" aria-labelledby="poster-name">
  <svg class="poster__mesh" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path d={mesh}></path>
  </svg>

  <!-- Barre système -->
  <div class="p-bar" aria-hidden="true">
    <span class="p-bar__mark">ab<i>.</i></span>
    <span>Curriculum vitae</span>
    <span class="p-bar__sep">2026</span>
    <span class="p-bar__slashes">/ / / / / / / / /</span>
  </div>

  <!-- Nom : le prénom en bleu sur la bande blanche, le nom en blanc sur le bleu -->
  <div class="p-band" aria-hidden="true"></div>
  <h1 class="p-name" id="poster-name">
    <span class="p-name__first">{profile.firstName}</span>
    <span class="p-name__last">{profile.lastName}</span>
  </h1>

  <p class="p-seek">
    <span class="p-seek__label">Recherche</span>
    <span class="p-seek__what">Alternance</span>
    <span class="p-seek__when">Janv. – août 2027</span>
  </p>

  <section class="win p-fiche" aria-labelledby="p-fiche-title">
    <header class="win__bar"><h2 id="p-fiche-title">Fiche</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <dl class="fiche">
      {
        fiche.map((row) => (
          <div>
            <dt>{row.label}</dt>
            <dd>{fr(row.value)}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="win p-profile" aria-labelledby="p-profile-title">
    <header class="win__bar"><h2 id="p-profile-title">Profil</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <div class="win__body">
      <p class="profile-text">{fr(cvSummary)}</p>
    </div>
  </section>

  <section class="win win--night p-radar" aria-labelledby="p-radar-title">
    <header class="win__bar"><h2 id="p-radar-title">Outils × projets</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <figure class="radar">
      <svg class="radar__mesh" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d={mesh}></path></svg>
      <svg class="radar__chart" viewBox="-1.85 -1.3 3.7 2.6" role="img" aria-labelledby="p-radar-desc" focusable="false">
        <defs>
          <filter id="radar-glow" x="-30%" y="-30%" width="160%" height="160%">
            <feGaussianBlur stdDeviation="0.04" result="blur" />
            <feMerge><feMergeNode in="blur" /><feMergeNode in="SourceGraphic" /></feMerge>
          </filter>
        </defs>
        {radarRings.map((ring) => <polygon class="radar__ring" points={ring} />)}
        {radar.map((axis) => <line class="radar__axis" x1="0" y1="0" x2={axis.cos.toFixed(3)} y2={axis.sin.toFixed(3)} />)}
        <polygon class="radar__shape" points={radarShape} filter="url(#radar-glow)" />
        {radar.map((axis) => <circle class="radar__dot" cx={((axis.value / radarMax) * axis.cos).toFixed(3)} cy={((axis.value / radarMax) * axis.sin).toFixed(3)} r="0.045" />)}
        {
          radar.map((axis) => (
            <text
              class="radar__label"
              x={(1.2 * axis.cos).toFixed(3)}
              y={(1.2 * axis.sin + 0.06).toFixed(3)}
              text-anchor={Math.abs(axis.cos) < 0.2 ? "middle" : axis.cos > 0 ? "start" : "end"}
            >
              {axis.label}
              <tspan class="radar__value">{` ${axis.value}`}</tspan>
            </text>
          ))
        }
      </svg>
      <figcaption id="p-radar-desc">
        Nombre de projets et d’expériences où chaque outil a servi : {radar.map((axis) => `${axis.label} ${axis.value}`).join(", ")}.
      </figcaption>
    </figure>
  </section>

  <section class="win p-side" aria-labelledby="p-lang-title">
    <header class="win__bar"><h2 id="p-lang-title">Langues</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <div class="win__body">
      <ul class="langs">
        {
          spoken.map((language) => (
            <li>
              <span class="langs__name">{language.name}</span>
              <span class="langs__level">{language.level}</span>
              <span class="langs__bar" aria-hidden="true">
                {cefr.map((_, i) => (
                  <i class:list={{ on: i < language.rank }} />
                ))}
              </span>
            </li>
          ))
        }
      </ul>
      <h2 class="side__title" id="p-hobbies-title">Hors écran</h2>
      <ul class="hobbies" aria-labelledby="p-hobbies-title">
        {
          cvInterests.map((item) => (
            <li>
              <svg viewBox="-1 -1 2 2" aria-hidden="true" focusable="false"><path d={sparkle} /></svg>
              {fr(item)}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="win p-exp" aria-labelledby="p-exp-title">
    <header class="win__bar"><h2 id="p-exp-title">Expérience</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <div class="win__body entries">
      {
        cvExperience.map((entry, i) => (
          <article class:list={["entry", { "entry--lead": i === 0 }]}>
            <p class="entry__when">{entry.when}</p>
            <h3 class="entry__title">{entry.title}</h3>
            <p class="entry__place">{entry.place}</p>
            {entry.brief && <p class="entry__brief">{fr(entry.brief)}</p>}
            {entry.logos && (
              <ul class="stack" aria-label="Technologies">
                {entry.logos.map((logo) => (
                  <li>
                    <Logo name={logo} labelled />
                  </li>
                ))}
              </ul>
            )}
          </article>
        ))
      }
    </div>
  </section>

  <section class="win p-proj" aria-labelledby="p-proj-title">
    <header class="win__bar"><h2 id="p-proj-title">Projets</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <div class="win__body projects">
      {
        projects.map((project) => (
          <article class="project">
            <span class="project__index" aria-hidden="true">{project.index}</span>
            <h3 class="project__title">
              <a href={project.href}>{project.title}</a>
            </h3>
            <p class="project__subtitle">{project.subtitle}</p>
            <ul class="stack" aria-label="Technologies">
              {project.logos.map((logo) => (
                <li>
                  <Logo name={logo} labelled />
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </section>

  <section class="win p-edu" aria-labelledby="p-edu-title">
    <header class="win__bar"><h2 id="p-edu-title">Formation</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <ol class="timeline">
      {
        timeline.map((step, i) => (
          <li class:list={["step", i % 2 ? "step--below" : "step--above", { "step--future": step.future }]} style={`--i: ${i}`}>
            <span class="step__when">{step.when}</span>
            <span class="step__title">{step.title}</span>
            <span class="step__place">{step.place}</span>
            {step.brief && <span class="step__brief">{fr(step.brief)}</span>}
          </li>
        ))
      }
    </ol>
  </section>

  <section class="win p-tools" aria-labelledby="p-tools-title">
    <header class="win__bar"><h2 id="p-tools-title">Langages et outils</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <div class="win__body toolbox">
      {
        cvToolbox.map((group) => (
          <div class="toolbox__row">
            <h3 class="toolbox__title">{group.title}</h3>
            <ul class="toolbox__icons">
              {group.items.map((item) => (
                <li class="tool">
                  <span class="tool__tile">
                    <Logo name={item.logo} />
                  </span>
                  <span class="tool__name">
                    {item.name}
                    {item.note && <small>{item.note}</small>}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
      <p class="toolbox__methods"><span>Aussi</span>{fr(cvMethods.join(" · "))}</p>
    </div>
  </section>

  <section class="win p-contact" aria-labelledby="p-contact-title">
    <header class="win__bar"><h2 id="p-contact-title">Contact</h2><span class="win__ctrl" aria-hidden="true"><i></i><i></i><i></i></span></header>
    <div class="win__body contact">
      <ul class="contact__list">
        <li><a href={`mailto:${profile.email}`}>{profile.email}</a></li>
        <li><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a></li>
        <li><a href={profile.github}>{shortUrl(profile.github).replace("github.com/", "github/")}</a></li>
        <li><a href={profile.linkedin}>linkedin/abdallah-borji</a></li>
        <li>{profile.location}</li>
      </ul>
      {
        site && (
          <a class="contact__qr" href={site}>
            <svg viewBox={`-2 -2 ${qrSize + 4} ${qrSize + 4}`} shape-rendering="crispEdges" aria-hidden="true" focusable="false">
              <rect x="-2" y="-2" width={qrSize + 4} height={qrSize + 4} class="qr__bg" />
              <path d={qrPath} class="qr__dots" />
            </svg>
            <span>Portfolio</span>
            <span class="visually-hidden"> : {shortUrl(site)}</span>
            <svg class="contact__cursor" viewBox="0 0 12 19" shape-rendering="crispEdges" aria-hidden="true" focusable="false">
              <path d={cursorPath("W")} class="cursor__fill" />
              <path d={cursorPath("B")} class="cursor__line" />
            </svg>
          </a>
        )
      }
    </div>
  </section>

  <div class="p-foot" aria-hidden="true">
    <span class="p-bar__slashes">/ / / / / /</span>
    <span>{site ? shortUrl(site) : profile.name}</span>
    <svg viewBox="-1 -1 2 2" focusable="false"><path d={sparkle} /></svg>
  </div>

  <svg class="p-sparkles" viewBox="0 0 210 297" aria-hidden="true" focusable="false">
    <path d={sparkle} transform="translate(97.5 57) scale(3.2)" />
    <path d={sparkle} transform="translate(102 66.5) scale(1.5)" />
    <!-- Quelques éclats dispersés : barre du haut, marges, pied de page, formation. -->
    <path d={sparkle} transform="translate(110 10.5) scale(2.2)" />
    <path d={sparkle} transform="translate(4.2 129) scale(1.4)" />
    <path d={sparkle} transform="translate(205.8 194) scale(1.2)" />
    <path d={sparkle} transform="translate(122 287) scale(1.8)" />
    <path d={sparkle} transform="translate(20.5 227.5) scale(1.6)" />
  </svg>
</article>

<style>
  /* ---------- La feuille : 210 × 297 « millimètres » ---------- */
  .poster {
    --u: calc(100cqi / 210);
    --blue: #1b19e6;
    --blue-deep: #1210b8;
    --night: #0d0c2b;
    --white: #f6f6ff;
    --lilac: #c4c2ff;
    --rule: rgb(196 194 255 / 62%);
    --line: max(1px, calc(0.26 * var(--u)));
    --pixel: "VT323", ui-monospace, monospace;
    --micro: "Silkscreen", ui-monospace, monospace;
    --mono: "JetBrains Mono", ui-monospace, Menlo, monospace;
    --t-micro: calc(1.85 * var(--u));
    --t-body: calc(2.2 * var(--u));
    --t-value: calc(3.5 * var(--u));
    --t-title: calc(4.4 * var(--u));

    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows:
      calc(5 * var(--u)) calc(30 * var(--u)) calc(30 * var(--u)) calc(46 * var(--u))
      calc(60 * var(--u)) calc(38 * var(--u)) calc(46 * var(--u)) calc(4 * var(--u));
    align-content: space-between;
    column-gap: calc(3 * var(--u));
    width: 100%;
    aspect-ratio: 210 / 297;
    padding: calc(8 * var(--u));
    overflow: hidden;
    background: var(--blue);
    color: var(--white);
    font-family: var(--mono);
    font-size: var(--t-body);
    font-weight: 400;
    line-height: 1.38;
    font-synthesis: none;
    font-kerning: none;
    text-rendering: optimizeLegibility;
    -webkit-font-smoothing: antialiased;
  }

  :where(.poster) :where(h1, h2, h3, p, ul, ol, dl, dd, figure) {
    margin: 0;
    padding: 0;
    font: inherit;
    letter-spacing: normal;
    list-style: none;
  }

  .poster a {
    color: inherit;
    text-decoration: none;
  }

  .poster ::selection {
    background: var(--white);
    color: var(--blue);
  }

  .poster :global(svg) {
    display: block;
  }

  /* Trame déformée en fond de feuille, visible dans les marges et les interstices. */
  .poster__mesh {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: rgb(255 255 255 / 20%);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    pointer-events: none;
  }

  .poster__mesh path,
  .radar__mesh path {
    vector-effect: non-scaling-stroke;
  }

  /* ---------- Barre système ---------- */
  .p-bar,
  .p-foot {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: calc(4 * var(--u));
    font-family: var(--micro);
    font-size: var(--t-micro);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--lilac);
  }

  .p-bar {
    grid-row: 1;
  }

  .p-bar__mark {
    font-family: var(--pixel);
    font-size: calc(5 * var(--u));
    line-height: 1;
    text-transform: none;
    color: var(--white);
  }

  .p-bar__mark i {
    font-style: normal;
    color: var(--lilac);
  }

  .p-bar__slashes {
    margin-left: auto;
    font-family: var(--pixel);
    font-size: calc(4.2 * var(--u));
    letter-spacing: 0.1em;
    white-space: nowrap;
  }

  .p-foot {
    grid-row: 8;
    position: relative;
  }

  .p-foot .p-bar__slashes {
    margin-left: 0;
  }

  .p-foot svg {
    width: calc(3 * var(--u));
    margin-left: auto;
    fill: var(--white);
  }

  /* ---------- Nom ---------- */
  .p-band {
    grid-column: 1 / -1;
    grid-row: 2;
    margin-inline: calc(-8 * var(--u));
    background: var(--white);
  }

  .p-name {
    grid-column: 1 / -1;
    grid-row: 2 / 4;
    display: grid;
    grid-template-rows: subgrid;
    font-family: var(--pixel);
    font-size: calc(41 * var(--u));
    font-weight: 400;
    line-height: 1;
    text-transform: uppercase;
    pointer-events: none;
  }

  .p-name > span {
    align-self: end;
    margin-left: calc(-1.2 * var(--u));
    margin-bottom: calc(-6.6 * var(--u));
    pointer-events: auto;
  }

  /* Le prénom, rempli de lignes de balayage comme un écran cathodique. */
  .p-name__first {
    color: var(--blue);
    background: repeating-linear-gradient(to bottom, var(--blue) 0 calc(1.55 * var(--u)), var(--blue-deep) calc(1.55 * var(--u)) calc(2.05 * var(--u)));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .p-name__last {
    color: var(--white);
    text-shadow: calc(1.2 * var(--u)) calc(1.2 * var(--u)) 0 rgb(13 12 43 / 55%);
  }

  /* L'alternance recherchée, à la place du numéro d'identifiant. */
  .p-seek {
    grid-column: 10 / -1;
    grid-row: 2;
    align-self: center;
    display: grid;
    justify-items: end;
    gap: calc(0.6 * var(--u));
    color: var(--blue);
    text-align: right;
  }

  .p-seek__label {
    font-family: var(--micro);
    font-size: var(--t-micro);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .p-seek__what {
    font-family: var(--pixel);
    font-size: calc(7.4 * var(--u));
    line-height: 0.8;
    text-transform: uppercase;
  }

  .p-seek__when {
    padding: calc(0.5 * var(--u)) calc(1.4 * var(--u)) calc(0.3 * var(--u));
