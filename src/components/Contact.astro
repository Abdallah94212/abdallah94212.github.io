---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <h2 class="contact__title" id="contact-title" data-reveal="title">Écrivez-moi<span class="contact__dot">.</span></h2>
    <p class="contact__intro" data-reveal="fade">Un projet, une opportunité ou une simple question : le plus direct reste un e-mail.</p>

    <div class="contact__email-row" data-reveal="fade">
      <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button class="contact__copy" type="button" data-copy={profile.email}>
        <Icon name="copy" class="contact__copy-icon" />
        <Icon name="check" class="contact__check-icon" />
        <span data-copy-label>Copier l’adresse</span>
      </button>
    </div>

    <div class="contact__grid">
      <dl class="contact__details">
        <div>
          <dt class="label">Téléphone</dt>
          <dd><a href={`tel:${profile.phoneHref}`}>{profile.phone}</a></dd>
        </div>
        <div>
          <dt class="label">Réseaux</dt>
          <dd class="contact__social">
            <a href={profile.linkedin} target="_blank" rel="noopener noreferrer"><Icon name="linkedin" /> LinkedIn</a>
            <a href={profile.github} target="_blank" rel="noopener noreferrer"><Icon name="github" /> GitHub</a>
          </dd>
        </div>
        <div>
          <dt class="label">Basé à</dt>
          <dd>{profile.location} · {profile.licence}</dd>
        </div>
      </dl>

      <form class="contact-form" data-contact-form action={`mailto:${profile.email}`} method="post" enctype="text/plain">
        <div class="field">
          <label for="contact-name">Votre nom</label>
          <input id="contact-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="100" required />
        </div>
        <div class="field">
          <label for="contact-email">Votre e-mail</label>
          <input id="contact-email" name="email" type="email" autocomplete="email" maxlength="254" required />
        </div>
        <div class="field field--full">
          <label for="contact-subject">Objet</label>
          <input id="contact-subject" name="subject" type="text" maxlength="150" required />
        </div>
        <div class="field field--full">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" name="message" rows="6" minlength="10" maxlength="3000" required></textarea>
        </div>
        <p class="form-note field--full" id="form-note">
          Le formulaire prépare l’e-mail dans votre messagerie : rien n’est envoyé ni enregistré par ce site.
        </p>
        <div class="form-actions field--full">
          <button class="button" type="submit" aria-describedby="form-note">Préparer l’e-mail <Icon name="arrow-right" /></button>
          <button class="link" type="button" data-draft-copy hidden>Copier le message</button>
        </div>
        <p class="form-status field--full" data-form-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section);
    border-top: 1px solid var(--line);
  }

  .contact__title {
    /* « Écrivez-moi. » mesure environ 5,9 em : il tient sur une ligne partout. */
    font-size: min(15.2vw, 13rem);
    white-space: nowrap;
    font-weight: 800;
    font-stretch: 118%;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }

  .contact__dot {
    color: var(--accent);
  }

  .contact__intro {
    max-width: 34ch;
    margin-top: 2rem;
    font-size: var(--fs-lead);
    line-height: 1.3;
    color: var(--muted);
  }

  .contact__email-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line);
  }

  .contact__email {
    font-size: clamp(1.4rem, 0.6rem + 3.6vw, 4.25rem);
    font-weight: 620;
    font-stretch: 104%;
    letter-spacing: -0.035em;
    line-height: 1.1;
    text-decoration: none;
    overflow-wrap: anywhere;
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 2px;
    transition:
      background-size 0.6s var(--ease-out),
      color var(--dur-fast);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__email:hover {
      color: var(--accent);
      background-size: 100% 2px;
    }
  }

  .contact__copy {
    display: inline-grid;
    grid-template-columns: auto auto;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: transparent;
    font-size: var(--fs-small);
    font-weight: 540;
    transition:
      border-color var(--dur-fast),
      transform var(--dur-fast) var(--ease-out);
  }

  .contact__copy:active {
    transform: scale(0.96);
  }

  .contact__copy :global(.contact__copy-icon),
  .contact__copy :global(.contact__check-icon) {
    grid-area: 1 / 1;
    transition:
      opacity 0.25s,
      transform 0.4s var(--ease-out);
  }

  .contact__copy :global(.contact__check-icon) {
    opacity: 0;
    transform: scale(0.4);
  }

  .contact__copy.is-copied :global(.contact__copy-icon) {
    opacity: 0;
    transform: scale(0.4);
  }

  .contact__copy.is-copied :global(.contact__check-icon) {
    opacity: 1;
    transform: none;
    color: var(--accent);
  }

  .contact__copy [data-copy-label] {
    grid-column: 2;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__copy:hover {
      border-color: var(--ink);
    }
  }

  .contact__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: clamp(1rem, 2vw, 2rem);
    row-gap: 3rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .contact__details {
    grid-column: 1 / 5;
    display: grid;
    align-content: start;
    gap: 1.75rem;
  }

  .contact__details dd {
    margin-top: 0.35rem;
    font-weight: 520;
  }

  .contact__details a {
    text-decoration: none;
  }

  .contact__social {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
  }

  .contact__social a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact__details a:hover {
      color: var(--accent);
    }
  }

  /* ---------- Formulaire ---------- */

  .contact-form {
    grid-column: 6 / -1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .field {
    display: grid;
    gap: 0.5rem;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  .field label {
    font-size: var(--fs-small);
    font-weight: 540;
  }

  .field input,
  .field textarea {
    width: 100%;
    min-height: 3.25rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-media);
    background: var(--bg-raised);
    font-size: 1rem;
    transition:
      border-color var(--dur-fast),
      box-shadow var(--dur-fast);
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .field input:focus-visible,
  .field textarea:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent);
  }

  .field input:user-invalid,
  .field textarea:user-invalid {
    border-color: #d23b3b;
  }

  .form-note {
    font-size: var(--fs-small);
    color: var(--muted);
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
  }

  .form-actions .link {
    border: 0;
    padding: 0;
    color: inherit;
  }

  .form-status {
    font-size: var(--fs-small);
    font-weight: 520;
  }

  .form-status:empty {
    display: none;
  }

  @media (max-width: 900px) {
    .contact__details,
    .contact-form {
      grid-column: 1 / -1;
    }

    .contact-form {
      grid-template-columns: 1fr;
    }

    .field {
      grid-column: 1 / -1;
    }
  }
</style>
