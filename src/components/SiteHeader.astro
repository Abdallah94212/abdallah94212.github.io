---
import Icon from "./Icon.astro";
import { profile } from "../data/profile";
import { url } from "../lib/url";

interface Props {
  page: "home" | "case" | "cv" | "404";
}

const { page } = Astro.props;
const sections = [
  { id: "projets", label: "Projets" },
  { id: "parcours", label: "Parcours" },
  { id: "competences", label: "Compétences" },
  { id: "contact", label: "Contact" },
];
const sectionHref = (id: string) => (page === "home" ? `#${id}` : url(`/#${id}`));
---

<header class="site-header" data-header>
  <div class="site-header__inner wrap">
    <a class="wordmark" href={url("/")}>
      ab<span class="wordmark__dot" aria-hidden="true">.</span><span class="visually-hidden"> {profile.name}, accueil</span>
    </a>

    <nav class="site-nav" aria-label="Navigation principale">
      <ul>
        {
          sections.map((section) => (
            <li>
              <a href={sectionHref(section.id)} data-nav-link={section.id}>
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a class="cv-link" href={url("/cv/")}>CV</a>
      <button class="icon-button" type="button" data-theme-toggle aria-label="Changer de thème">
        <Icon name="moon" class="theme-icon theme-icon--moon" />
        <Icon name="sun" class="theme-icon theme-icon--sun" />
      </button>
      <button class="menu-toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu-mobile">
        <span class="menu-toggle__label" data-menu-label>Menu</span>
        <span class="menu-toggle__bars" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>
</header>

<div class="mobile-menu" id="menu-mobile" data-menu hidden>
  <nav class="mobile-menu__nav wrap" aria-label="Navigation mobile">
    <ul>
      {
        sections.map((section, index) => (
          <li style={`--i: ${index}`}>
            <a href={sectionHref(section.id)} data-menu-link>
              {section.label}
            </a>
          </li>
        ))
      }
      <li style={`--i: ${sections.length}`}><a href={url("/cv/")} data-menu-link>CV</a></li>
    </ul>
    <div class="mobile-menu__footer">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <div class="mobile-menu__social">
        <a href={profile.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
      </div>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    color: var(--top-ink, var(--ink));
    transition:
      transform 0.5s var(--ease-out),
      color var(--dur) var(--ease-out);
  }

  /* Un voile apparaît dès que la page défile, pour garder les liens lisibles. */
  .site-header::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transition: opacity var(--dur) var(--ease-out);
  }

  .site-header.is-scrolled {
    color: var(--ink);
  }

  /* Sur l'accueil, l'en-tête descend pendant l'entrée en scène du nom. */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-page="home"]:not(.intro-seen)) .site-header__inner {
      animation: header-in 1.1s var(--ease-out) 0.2s backwards;
    }
  }

  @keyframes header-in {
    from {
      opacity: 0;
      transform: translateY(-100%);
    }
  }

  .site-header.is-scrolled::before {
    opacity: 1;
  }

  .site-header.is-hidden {
    transform: translateY(-100%);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: var(--header-h);
  }

  .wordmark {
    font-size: 1.85rem;
    font-weight: 800;
    font-stretch: 112%;
    letter-spacing: -0.06em;
    line-height: 1;
    text-decoration: none;
  }

  .wordmark__dot {
    display: inline-block;
    color: var(--accent);
    transition: transform var(--dur) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .wordmark:hover .wordmark__dot {
      transform: translateY(-0.35em);
    }
  }

  .site-nav {
    margin-left: auto;
  }

  .site-nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .site-nav a {
    position: relative;
    display: block;
    padding: 0.6rem 0.85rem;
    font-size: var(--fs-small);
    font-weight: 500;
    text-decoration: none;
  }

  /* Le repère actif glisse sous le lien de la section lue. */
  .site-nav a::after {
    content: "";
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.35rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform var(--dur) var(--ease-out);
  }

  .site-nav a[aria-current="true"]::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-nav a:hover::after {
      transform: scaleX(1);
      transform-origin: left;
    }
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .cv-link {
    display: inline-flex;
    align-items: center;
    height: 2.5rem;
    padding: 0 1rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: var(--fs-small);
    font-weight: 560;
    text-decoration: none;
    transition:
      background-color var(--dur-fast),
      color var(--dur-fast);
  }

  .icon-button {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: transparent;
    font-size: 1.1rem;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .icon-button:active {
    transform: scale(0.94);
  }

  .icon-button :global(.theme-icon) {
    grid-area: 1 / 1;
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.3s;
  }

  .icon-button :global(.theme-icon--sun) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.6);
  }

  :global([data-theme="dark"]) .icon-button :global(.theme-icon--sun) {
    opacity: 1;
    transform: none;
  }

  :global([data-theme="dark"]) .icon-button :global(.theme-icon--moon) {
    opacity: 0;
    transform: rotate(90deg) scale(0.6);
  }

  @media (hover: hover) and (pointer: fine) {
    .cv-link:hover {
      background: var(--ink);
      border-color: var(--ink);
      color: var(--bg);
    }
  }

  .menu-toggle {
    display: none;
    align-items: center;
    gap: 0.6rem;
    height: 2.5rem;
    padding: 0 0.25rem 0 0.75rem;
    border: 0;
    background: transparent;
    font-size: var(--fs-small);
    font-weight: 560;
  }

  .menu-toggle__bars {
    position: relative;
    width: 1.35rem;
    height: 0.6rem;
  }

  .menu-toggle__bars span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.45s var(--ease-out);
  }

  .menu-toggle__bars span:first-child {
    top: 0;
  }

  .menu-toggle__bars span:last-child {
    bottom: 0;
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:first-child {
    transform: translateY(0.27rem) rotate(45deg);
  }

  .menu-toggle[aria-expanded="true"] .menu-toggle__bars span:last-child {
    transform: translateY(-0.27rem) rotate(-45deg);
  }

  /* ---------- Menu mobile ---------- */

  /* Le menu se déroule depuis le haut, puis les liens montent l'un après l'autre. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    display: flex;
    background: var(--ink);
    color: var(--bg);
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    overflow-y: auto;
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.7s var(--ease-in-out);
  }

  .mobile-menu.is-open {
    clip-path: inset(0 0 0% 0);
  }

  .mobile-menu ul li {
    opacity: 0;
    transform: translateY(60%);
    transition:
      opacity 0.5s var(--ease-out),
      transform 0.9s var(--ease-out);
  }

  .mobile-menu.is-open ul li {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.25s + var(--i, 0) * 0.05s);
  }

  :global(html.menu-open) .site-header {
    z-index: calc(var(--z-menu) + 1);
    color: var(--bg);
    transform: none;
  }

  :global(html.menu-open) .site-header::before {
    opacity: 0;
  }

  .mobile-menu__nav {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 3rem;
  }

  .mobile-menu ul {
    display: grid;
    gap: 0.25rem;
  }

  .mobile-menu ul a {
    display: block;
    padding-block: 0.15rem;
    font-size: clamp(2.75rem, 13vw, 5rem);
    font-weight: 760;
    font-stretch: 118%;
    letter-spacing: -0.045em;
    line-height: 1.05;
    text-decoration: none;
  }

  .mobile-menu__footer {
    display: grid;
    gap: 1rem;
    font-size: var(--fs-small);
  }

  .mobile-menu__social {
    display: flex;
    gap: 1.5rem;
  }

  @media (max-width: 900px) {
    .site-nav {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }

    .site-header__actions {
      margin-left: auto;
    }
  }

  @media (max-width: 420px) {
    .cv-link {
      display: none;
    }
  }
</style>
